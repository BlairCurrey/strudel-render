{
  "name": "strudel-render",
  "version": "0.1.0",
  "description": "Render Strudel pattern files to audio from the command line — strudel's own engine in headless Chrome, several chunks in parallel",
  "keywords": [
    "strudel",
    "tidalcycles",
    "live-coding",
    "music",
    "audio",
    "render",
    "export",
    "superdough",
    "wav",
    "mp3"
  ],
  "license": "AGPL-3.0-or-later",
  "author": "Blair Currey",
  "type": "module",
  "bin": {
    "strudel-render": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/render.d.ts",
      "default": "./dist/render.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs && tsc",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "render": "node src/cli.ts",
    "test": "npm run build && node --test --test-reporter=spec 'test/*.test.ts'",
    "references": "node scripts/make-references.mjs"
  },
  "dependencies": {
    "playwright-core": "^1.63.0"
  },
  "devDependencies": {
    "@strudel/core": "^1.2.6",
    "@strudel/mini": "^1.2.6",
    "@strudel/soundfonts": "^1.3.0",
    "@strudel/tonal": "^1.2.6",
    "@strudel/transpiler": "^1.2.6",
    "@strudel/webaudio": "^1.3.0",
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "superdough": "^1.3.0",
    "typescript": "^7.0.2"
  }
}
